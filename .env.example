# Copia a .env (git-ignored). scripts/setup.ps1 crea .env automáticamente y completa
# los valores marcados como <generado>. Todo es de desarrollo local: no hay claves reales.

# --- n8n -------------------------------------------------------------------------------
N8N_HOST_PORT=15678
# Clave de cifrado de credenciales de n8n (32 bytes hex). <generado>
N8N_ENCRYPTION_KEY=
# Cuenta owner LOCAL de prueba (sólo existe en esta instancia). <generado>
N8N_OWNER_EMAIL=owner@n8n-recon.test
N8N_OWNER_PASSWORD=
# API key de la API pública de n8n, creada por setup.ps1 para el e2e. <generado>
N8N_API_KEY=

# --- Mailpit ---------------------------------------------------------------------------
MAILPIT_UI_PORT=18825
MAILPIT_SMTP_PORT=11825
MAIL_FROM=n8n-conciliacion@example.test
MAIL_REVIEWER=revisor@example.test
MAIL_OPS=operaciones@example.test

# --- API de conciliación (fintech-ai-reconciliation-agent, stack recon-m0) -------------
RECON_API_BASE_URL=http://host.docker.internal:18180
# Carpeta .dev-keys del proyecto de conciliación: setup.ps1 lee private.pem para crear la
# credencial JWT de n8n (cifrada en su base) y jwks.json para el kid. La clave nunca entra a git.
RECON_DEV_KEYS_DIR=../fintech-ai-reconciliation-agent/.dev-keys
RECON_JWT_KID=
RECON_JWT_ISSUER=recon-dev-idp
RECON_JWT_AUDIENCE=recon-api
RECON_TENANT_PREFIX=n8n
RECON_RUN_POLL_MAX=30
RECON_INVESTIGATION_TIMEOUT_S=90

# --- Ollama local ----------------------------------------------------------------------
OLLAMA_BASE_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_TIMEOUT_MS=90000

# Inyección de fallas sólo para pruebas (permite `test_fault` en el payload). Nunca en prod.
RECON_FAULT_INJECTION=false
